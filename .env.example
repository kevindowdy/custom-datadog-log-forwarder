# Datadog credentials (required).
DD_API_KEY=

# Datadog site (optional; defaults to datadoghq.com).
# DD_SITE=us5.datadoghq.com

# Override the Logs Submit endpoint entirely (optional; e.g. an internal proxy).
# DD_API_BASE_URL=

# Directory containing the source application's rotated log files (required).
LOG_DIR=C:\Users\fbfepde\Documents\Temporary\FIG_App_Logs

# Go time.Format layout for today's log file's *name only* (required).
# Matches fetch-open-vulnerabilities' saltminer_download_YYYYMMDD.log naming.
LOG_FILE_NAME_PATTERN=saltminer_download_20060102.log

# Directory for this app's own per-day dedup tracking files (optional).
# LOGS_SENT_DIR=./logs_sent

# How many days of dedup tracking files to keep before pruning (optional).
# LOGS_SENT_RETENTION_DAYS=7

# Optional Datadog tag overrides for forwarded logs.
# DD_LOG_SOURCE=fetch-open-vulnerabilities
# DD_LOG_SERVICE=fetch-open-vulnerabilities
# DD_LOG_TAGS=env:prod
# DD_LOG_HOSTNAME=

# Optional batching limits for the Datadog Logs API.
# BATCH_MAX_ITEMS=400
# BATCH_MAX_BYTES=3145728
